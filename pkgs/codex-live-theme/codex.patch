+#[cfg(test)]
+mod live_palette_tests {
+    use super::*;
+
+    #[test]
+    fn color_pair_is_atomic_and_accepts_either_reply_order() {
+        let mut refresh = PaletteRefresh::default();
+        assert_eq!(refresh.accept(11, Some((238, 240, 228))), None);
+        assert_eq!(
+            refresh.accept(10, Some((42, 51, 41))),
+            Some(DefaultColors {
+                fg: (42, 51, 41),
+                bg: (238, 240, 228)
+            })
+        );
+        assert_eq!(refresh.accept(10, Some((212, 210, 226))), None);
+        assert_eq!(
+            refresh.accept(11, Some((30, 34, 51))),
+            Some(DefaultColors {
+                fg: (212, 210, 226),
+                bg: (30, 34, 51)
+            })
+        );
+    }
+
+    #[test]
+    fn incomplete_or_invalid_replies_do_not_publish_a_palette() {
+        let mut refresh = PaletteRefresh::default();
+        assert_eq!(refresh.accept(10, Some((42, 51, 41))), None);
+        assert_eq!(refresh.accept(11, None), None);
+        assert_eq!(refresh.accept(4, Some((0, 0, 0))), None);
+        // A new query drops an incomplete pair before accepting another generation.
+        refresh = PaletteRefresh::default();
+        assert_eq!(refresh.accept(11, Some((30, 34, 51))), None);
+        assert_eq!(
+            refresh.accept(10, Some((212, 210, 226))),
+            Some(DefaultColors {
+                fg: (212, 210, 226),
+                bg: (30, 34, 51)
+            })
+        );
+    }
+}
