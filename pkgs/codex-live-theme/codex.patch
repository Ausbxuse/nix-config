-#[derive(Clone, Copy)]
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
 pub struct DefaultColors {
     fg: (u8, u8, u8),
     bg: (u8, u8, u8),
 }
 
+// A complete pair is committed together; missing or malformed replies never erase
+// the last usable palette. The event stream remains the only terminal reader.
+#[derive(Default)]
+pub(crate) struct PaletteRefresh {
+    fg: Option<(u8, u8, u8)>,
+    bg: Option<(u8, u8, u8)>,
+}
+
+impl PaletteRefresh {
+    pub(crate) fn accept(&mut self, slot: u8, rgb: Option<(u8, u8, u8)>) -> Option<DefaultColors> {
+        match slot {
+            10 => self.fg = rgb,
+            11 => self.bg = rgb,
+            _ => return None,
+        }
+        let colors = DefaultColors {
+            fg: self.fg?,
+            bg: self.bg?,
+        };
+        *self = Self::default();
+        Some(colors)
+    }
+}
+
+static PALETTE_CHANGED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+pub(crate) fn update_default_colors(colors: DefaultColors) -> bool {
+    let changed = imp::update_default_colors(colors);
+    if changed {
+        PALETTE_CHANGED.store(true, std::sync::atomic::Ordering::Release);
+    }
+    changed
+}
+
+pub(crate) fn take_palette_changed() -> bool {
+    PALETTE_CHANGED.swap(false, std::sync::atomic::Ordering::AcqRel)
+}
