         assert!(InternalEventFilter.eval(&InternalEvent::Event(Event::Resize(10, 10))));
         assert!(InternalEventFilter.eval(&InternalEvent::CursorPosition(0, 0)));
     }
+    #[cfg(feature = "event-stream")]
+    #[test]
+    fn stream_filter_delivers_default_colors_and_user_input() {
+        use super::StreamEventFilter;
+        use crate::event::{KeyCode, KeyEvent, KeyModifiers};
+        let key = InternalEvent::Event(Event::Key(KeyEvent::new(
+            KeyCode::Char('x'),
+            KeyModifiers::NONE,
+        )));
+        let color = InternalEvent::OscColor {
+            slot: 11,
+            payload: OscColorPayload::Rgb {
+                r: 238,
+                g: 240,
+                b: 228,
+            },
+        };
+        assert!(StreamEventFilter.eval(&key));
+        assert!(StreamEventFilter.eval(&color));
+        assert!(!EventFilter.eval(&color));
+        assert!(!StreamEventFilter.eval(&InternalEvent::CursorPosition(2, 3)));
+    }
 }
