+/// The asynchronous reader also delivers default-color replies to its consumer.
+/// Synchronous color-query helpers keep using their existing slot-specific filter.
+#[cfg(feature = "event-stream")]
+#[derive(Debug, Clone)]
+pub(crate) struct StreamEventFilter;
+
+#[cfg(feature = "event-stream")]
+impl Filter for StreamEventFilter {
+    fn eval(&self, event: &InternalEvent) -> bool {
+        if EventFilter.eval(event) {
+            return true;
+        }
+        #[cfg(unix)]
+        if matches!(event, InternalEvent::OscColor { slot: 10 | 11, .. }) {
+            return true;
+        }
+        false
+    }
+}
+
 #[cfg(test)]
